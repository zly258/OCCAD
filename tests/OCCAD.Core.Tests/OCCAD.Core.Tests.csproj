<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <OutputType>Exe</OutputType>
    <EnableMSTestRunner>true</EnableMSTestRunner>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MSTest" Version="4.0.2" />
    <ProjectReference Include="../../src/OCCAD.Core/OCCAD.Core.csproj" />
    <Reference Include="OcctNet" HintPath="$(OcctBridgeDistRoot)/OcctNet.dll" />
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
    <None Include="$(OcctBridgeDistRoot)/$(OcctBridgeNativeFileName)" Link="$(OcctBridgeNativeFileName)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
