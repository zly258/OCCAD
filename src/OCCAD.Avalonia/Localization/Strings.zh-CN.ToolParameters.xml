<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- Regular polygon -->
    <sys:String x:Key="Cad.Parameter.regularpolygon.sides">边数</sys:String>
    <sys:String x:Key="Cad.Parameter.regularpolygon.mode">方式</sys:String>
    <sys:String x:Key="Cad.Precision.regularpolygon.1.Length">半径</sys:String>
    <sys:String x:Key="Cad.Precision.regularpolygon.1.Angle">起始角度</sys:String>

    <!-- Ellipse -->
    <sys:String x:Key="Cad.Parameter.ellipse.Method">绘制方式</sys:String>
    <sys:String x:Key="Cad.Parameter.ellipse.MajorRadius">长轴半径</sys:String>
    <sys:String x:Key="Cad.Parameter.ellipse.MinorRadius">短轴半径</sys:String>
    <sys:String x:Key="Cad.Parameter.ellipse.Angle">长轴角度</sys:String>
    <sys:String x:Key="Cad.Prompt.Ellipse.AxisFirst">椭圆：指定长轴第一个端点 [Esc 取消]</sys:String>
    <sys:String x:Key="Cad.Prompt.Ellipse.AxisSecond">椭圆：指定长轴第二个端点 [Backspace 返回，Esc 取消]</sys:String>
    <sys:String x:Key="Cad.Prompt.Ellipse.InvalidMinor">椭圆：短轴半径必须大于 0 且不能超过长轴半径。</sys:String>

    <!-- Box -->
    <sys:String x:Key="Cad.Precision.box.1.Length">底面对角线长度</sys:String>
    <sys:String x:Key="Cad.Precision.box.1.Angle">底面对角线角度</sys:String>
    <sys:String x:Key="Cad.Precision.box.2.Length">高度</sys:String>

    <!-- Cylinder -->
    <sys:String x:Key="Cad.Parameter.cylinder.Radius">半径</sys:String>
    <sys:String x:Key="Cad.Parameter.cylinder.Height">高度</sys:String>
    <sys:String x:Key="Cad.Precision.cylinder.1.Length">半径</sys:String>
    <sys:String x:Key="Cad.Precision.cylinder.2.Length">高度</sys:String>

    <!-- Cone -->
    <sys:String x:Key="Cad.Parameter.cone.BaseRadius">底面半径</sys:String>
    <sys:String x:Key="Cad.Parameter.cone.Height">高度</sys:String>
    <sys:String x:Key="Cad.Precision.cone.1.Length">底面半径</sys:String>
    <sys:String x:Key="Cad.Precision.cone.2.Length">高度</sys:String>

    <!-- Sphere -->
    <sys:String x:Key="Cad.Parameter.sphere.Radius">半径</sys:String>
    <sys:String x:Key="Cad.Precision.sphere.1.Length">半径</sys:String>

    <!-- Frustum -->
    <sys:String x:Key="Cad.Parameter.frustum.BaseRadius">底面半径</sys:String>
    <sys:String x:Key="Cad.Parameter.frustum.Height">高度</sys:String>
    <sys:String x:Key="Cad.Parameter.frustum.TopRadius">顶面半径</sys:String>
    <sys:String x:Key="Cad.Precision.frustum.1.Length">底面半径</sys:String>
    <sys:String x:Key="Cad.Precision.frustum.2.Length">高度</sys:String>
    <sys:String x:Key="Cad.Precision.frustum.3.Length">顶面半径</sys:String>

    <!-- Torus -->
    <sys:String x:Key="Cad.Parameter.torus.MajorRadius">主半径</sys:String>
    <sys:String x:Key="Cad.Parameter.torus.TubeRadius">管半径</sys:String>
    <sys:String x:Key="Cad.Precision.torus.1.Length">主半径</sys:String>
    <sys:String x:Key="Cad.Precision.torus.2.Length">管半径</sys:String>

    <!-- Arc prompts used by the multi-method tool -->
    <sys:String x:Key="Cad.Prompt.Arc.Center">圆弧：指定圆心 [Esc 取消]</sys:String>
    <sys:String x:Key="Cad.Prompt.Arc.Start">圆弧：指定起点 [Backspace 返回，Esc 取消]</sys:String>
    <sys:String x:Key="Cad.Prompt.Arc.End">圆弧：指定终点 [Backspace 返回，Esc 取消]</sys:String>
    <sys:String x:Key="Cad.Prompt.Arc.CenterForEndpoints">圆弧：指定圆心所在侧及位置 [Backspace 返回，Esc 取消]</sys:String>
    <sys:String x:Key="Cad.Prompt.Arc.PointOnArc">圆弧：指定圆弧上的一点 [Backspace 返回，Esc 取消]</sys:String>
    <sys:String x:Key="Cad.Prompt.Arc.Tangent">圆弧：指定起点切线方向 [Backspace 返回，Esc 取消]</sys:String>
    <sys:String x:Key="Cad.Prompt.Arc.Invalid">圆弧：当前输入无法确定有效圆弧。</sys:String>
</ResourceDictionary>
