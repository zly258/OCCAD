<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>OCCAD</AssemblyName>
    <RootNamespace>OCCAD.Avalonia</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\OCCAD.Core\OCCAD.Core.csproj" />
    <PackageReference Include="Avalonia" Version="12.1.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.1.0" />
    <Reference Include="OcctNet">
      <HintPath>$(OcctBridgeSdkRoot)\OcctNet.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="OcctNet.Avalonia">
      <HintPath>$(OcctBridgeSdkRoot)\OcctNet.Avalonia.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <EmbeddedResource Include="Localization\Strings.*.xml" />
  </ItemGroup>
  <Target Name="ValidateCadAvaloniaBridgeSdk" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(OcctBridgeSdkRoot)\OcctNet.Avalonia.dll')" Text="OcctNet.Avalonia.dll is missing. Install the shared OcctCSharpBridge SDK or set OCCTCSHARPBRIDGE_SDK." />
    <Error Condition="!Exists('$(OcctBridgeSdkRoot)\OcctNative.dll')" Text="OcctNative.dll is missing. Install the shared OcctCSharpBridge SDK or set OCCTCSHARPBRIDGE_SDK." />
  </Target>
  <Target Name="CopyCadNativeBridge" AfterTargets="Build">
    <Copy SourceFiles="$(OcctBridgeSdkRoot)\OcctNative.dll" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
