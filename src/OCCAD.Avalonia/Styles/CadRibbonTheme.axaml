<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Ribbon-only styles. Keep ordinary property editors, dialogs and ComboBoxes untouched. -->
  <Style Selector="TabControl.cad-ribbon-tabs">
    <Setter Property="Background" Value="#FFFFFF" />
    <Setter Property="BorderBrush" Value="#CBD5DE" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <Style Selector="TabItem.cad-ribbon-tab">
    <Setter Property="MinWidth" Value="56" />
    <Setter Property="Height" Value="25" />
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="Margin" Value="1,1,1,0" />
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="FontFamily" Value="Noto Sans CJK SC, Microsoft YaHei UI, PingFang SC, Segoe UI, sans-serif" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="#22313F" />
  </Style>
  <Style Selector="TabItem.cad-ribbon-tab:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#EEF3F7" />
    <Setter Property="Foreground" Value="#22313F" />
  </Style>
  <Style Selector="TabItem.cad-ribbon-tab:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="#FFFFFF" />
    <Setter Property="Foreground" Value="#2F6F9F" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Button.cad-ribbon-button">
    <Setter Property="Height" Value="28" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Padding" Value="6,1" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="#22313F" />
    <Setter Property="FontFamily" Value="Noto Sans CJK SC, Microsoft YaHei UI, PingFang SC, Segoe UI, sans-serif" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="Button.cad-ribbon-button:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#EEF3F7" />
    <Setter Property="BorderBrush" Value="#CBD5DE" />
    <Setter Property="Foreground" Value="#22313F" />
  </Style>
  <Style Selector="Button.cad-ribbon-button:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="#E9EEF2" />
    <Setter Property="BorderBrush" Value="#2F6F9F" />
    <Setter Property="Foreground" Value="#22313F" />
  </Style>
  <Style Selector="Button.cad-ribbon-button:disabled">
    <Setter Property="Opacity" Value="0.45" />
  </Style>

  <Style Selector="TextBlock.cad-ribbon-caption">
    <Setter Property="Foreground" Value="#5B6875" />
    <Setter Property="FontFamily" Value="Noto Sans CJK SC, Microsoft YaHei UI, PingFang SC, Segoe UI, sans-serif" />
    <Setter Property="FontSize" Value="10" />
  </Style>

  <Style Selector="Border.cad-ribbon-shell">
    <Setter Property="Background" Value="#FFFFFF" />
    <Setter Property="BorderBrush" Value="#CBD5DE" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
</Styles>
