<Window x:Class="OCCAD.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:occt="clr-namespace:OcctNet;assembly=OcctNet.Wpf"
        xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
        xmlns:wf="clr-namespace:System.Windows.Forms;assembly=System.Windows.Forms"
        Title="OCCAD"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Width="1100"
        Height="700"
        MinWidth="760"
        MinHeight="480"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewKeyDown="MainWindowPreviewKeyDown">
    <DockPanel LastChildFill="True">
        <Menu x:Name="MainMenu" DockPanel.Dock="Top">
            <MenuItem Header="{DynamicResource Cad.Text.File}">
                <MenuItem Header="{DynamicResource Cad.Text.New}" Click="NewClick" InputGestureText="Ctrl+N"/>
                <MenuItem Header="{DynamicResource Cad.Text.Open}" Click="OpenClick" InputGestureText="Ctrl+O"/>
                <Separator/>
                <MenuItem Header="{DynamicResource Cad.Text.Save}" Click="SaveClick" InputGestureText="Ctrl+S"/>
                <MenuItem Header="{DynamicResource Cad.Text.SaveAs}" Click="SaveAsClick" InputGestureText="Ctrl+Shift+S"/>
                <Separator/>
                <MenuItem Header="{DynamicResource Cad.Text.ClearModel}" Click="ClearClick"/>
                <Separator/>
                <MenuItem Header="{DynamicResource Cad.Text.Exit}" Click="ExitClick"/>
            </MenuItem>
            <MenuItem Header="{DynamicResource Cad.Text.Edit}">
                <MenuItem x:Name="UndoMenuItem" Header="{DynamicResource Cad.Text.Undo}" Tag="edit.undo" IsEnabled="False" Click="ActionClick"/>
                <MenuItem x:Name="RedoMenuItem" Header="{DynamicResource Cad.Text.Redo}" Tag="edit.redo" IsEnabled="False" Click="ActionClick"/>
                <Separator/>
                <MenuItem Header="{DynamicResource Cad.Text.Select}" Tag="select" Click="ActionClick"/>
                <MenuItem Header="{DynamicResource Cad.Text.SelectAll}" Tag="select.all" Click="ActionClick"/>
                <MenuItem Header="{DynamicResource Cad.Text.SelectInvert}" Tag="select.invert" Click="ActionClick"/>
                <Separator/>
                <MenuItem Header="{DynamicResource Cad.Text.Delete}" Tag="edit.delete" Click="ActionClick"/>
            </MenuItem>
            <MenuItem Header="{DynamicResource Cad.Text.Draw}">
                <MenuItem Header="{DynamicResource Cad.Text.Text}" Tag="draw.text" Click="ActionClick"/>
                <Separator/>
                <MenuItem Header="{DynamicResource Cad.Text.Point}" Tag="draw.point" Click="ActionClick"/>
                <MenuItem Header="{DynamicResource Cad.Text.Line}" Tag="draw.line" Click="ActionClick"/>
                <MenuItem Header="{DynamicResource Cad.Text.Polyline}" Tag="draw.polyline" Click="ActionClick"/>
                <MenuItem Header="{DynamicResource Cad.Text.Rectangle}" Tag="draw.rectangle" Click="ActionClick"/>
                <MenuItem Header="{DynamicResource Cad.Text.Polygon}" Tag="draw.polygon" Click="ActionClick"/>
                <MenuItem Header="{DynamicResource Cad.Text.RegularPolygon}" Tag="draw.regularpolygon" Click="ActionClick"/>
                <Separator/>
                <MenuItem Header="{DynamicResource Cad.Text.Circle}">
                    <MenuItem Header="{DynamicResource Cad.Parameter.circle.Method.CenterRadius}" Tag="draw.circle.centerradius" Click="ActionClick"/>
                    <MenuItem Header="{DynamicResource Cad.Parameter.circle.Method.CenterDiameter}" Tag="draw.circle.centerdiameter" Click="ActionClick"/>
                    <MenuItem Header="{DynamicResource Cad.Parameter.circle.Method.TwoPoints}" Tag="draw.circle.twopoints" Click="ActionClick"/>
                    <MenuItem Header="{DynamicResource Cad.Parameter.circle.Method.ThreePoints}" Tag="draw.circle.threepoints" Click="ActionClick"/>
                    <MenuItem Header="{DynamicResource Cad.Parameter.circle.Method.PointCenter}" Tag="draw.circle.pointcenter" Click="ActionClick"/>
                </MenuItem>
                <MenuItem Header="{DynamicResource Cad.Text.Arc}">
                    <MenuItem Header="{DynamicResource Cad.Parameter.arc.Method.ThreePoints}" Tag="draw.arc.threepoints" Click="ActionClick"/>
                    <MenuItem Header="{DynamicResource Cad.Parameter.arc.Method.CenterStartEnd}" Tag="draw.arc.centerstartend" Click="ActionClick"/>
                    <MenuItem Header="{DynamicResource Cad.Parameter.arc.Method.StartCenterEnd}" Tag="draw.arc.startcenterend" Click="ActionClick"/>
                    <MenuItem Header="{DynamicResource Cad.Parameter.arc.Method.StartEndCenter}" Tag="draw.arc.startendcenter" Click="ActionClick"/>
                    <MenuItem Header="{DynamicResource Cad.Parameter.arc.Method.StartEndPoint}" Tag="draw.arc.startendpoint" Click="ActionClick"/>
                </MenuItem>
                <MenuItem Header="{DynamicResource Cad.Text.Ellipse}">
                    <MenuItem Header="{DynamicResource Cad.Parameter.ellipse.Method.CenterMajorMinor}" Tag="draw.ellipse.centermajorminor" Click="ActionClick"/>
                    <MenuItem Header="{DynamicResource Cad.Parameter.ellipse.Method.AxisEndpointsMinor}" Tag="draw.ellipse.axisendpointsminor" Click="ActionClick"/>
                </MenuItem>
                <MenuItem Header="{DynamicResource Cad.Text.Spline}" Tag="draw.spline" Click="ActionClick"/>
                <Separator/>
                <MenuItem Header="{DynamicResource Cad.Text.Solids}">
                    <MenuItem Header="{DynamicResource Cad.Text.Box}" Tag="solid.box" Click="ActionClick"/>
                    <MenuItem Header="{DynamicResource Cad.Text.Cylinder}" Tag="solid.cylinder" Click="ActionClick"/>
                    <MenuItem Header="{DynamicResource Cad.Text.Cone}" Tag="solid.cone" Click="ActionClick"/>
                    <MenuItem Header="{DynamicResource Cad.Text.Frustum}" Tag="solid.frustum" Click="ActionClick"/>
                    <MenuItem Header="{DynamicResource Cad.Text.Sphere}" Tag="solid.sphere" Click="ActionClick"/>
                    <MenuItem Header="{DynamicResource Cad.Text.Ellipsoid}" Tag="solid.ellipsoid" Click="ActionClick"/>
                    <MenuItem Header="{DynamicResource Cad.Text.Torus}" Tag="solid.torus" Click="ActionClick"/>
                    <Separator/>
                    <MenuItem Header="{DynamicResource Cad.Text.Helix}" Tag="solid.helix" Click="ActionClick"/>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="{DynamicResource Cad.Text.Modify}">
                <MenuItem Header="{DynamicResource Cad.Text.Move}" Tag="modify.move" Click="ActionClick"/>
                <MenuItem Header="{DynamicResource Cad.Text.Copy}" Tag="modify.copy" Click="ActionClick"/>
                <MenuItem Header="{DynamicResource Cad.Text.Rotate}" Tag="modify.rotate" Click="ActionClick"/>
                <MenuItem Header="{DynamicResource Cad.Text.Mirror}" Tag="modify.mirror" Click="ActionClick"/>
                <MenuItem Header="{DynamicResource Cad.Text.Scale}" Tag="modify.scale" Click="ActionClick"/>
                <Separator/>
                <MenuItem Header="{DynamicResource Cad.Text.Trim}" Tag="modify.trim" Click="ActionClick"/>
                <MenuItem Header="{DynamicResource Cad.Text.Extend}" Tag="modify.extend" Click="ActionClick"/>
                <MenuItem Header="{DynamicResource Cad.Text.Offset}" Tag="modify.offset" Click="ActionClick"/>
                <Separator/>
                <MenuItem Header="{DynamicResource Cad.Text.Array}">
                    <MenuItem Header="{DynamicResource Cad.Text.RectangularArray}" Tag="modify.rectarray" Click="ActionClick"/>
                    <MenuItem Header="{DynamicResource Cad.Text.CircularArray}" Tag="modify.circlearray" Click="ActionClick"/>
                    <MenuItem Header="{DynamicResource Cad.Text.PathArray}" Tag="modify.patharray" Click="ActionClick"/>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="{DynamicResource Cad.Text.Annotation}">
                <MenuItem Header="{DynamicResource Cad.Text.LengthDimension}" Tag="annotation.lengthdimension" Click="ActionClick"/>
                <MenuItem Header="{DynamicResource Cad.Text.AngleDimension}" Tag="annotation.angledimension" Click="ActionClick"/>
                <MenuItem Header="{DynamicResource Cad.Text.RadiusDimension}" Tag="annotation.radiusdimension" Click="ActionClick"/>
                <MenuItem Header="{DynamicResource Cad.Text.DiameterDimension}" Tag="annotation.diameterdimension" Click="ActionClick"/>
            </MenuItem>
            <MenuItem Header="{DynamicResource Cad.Text.Measure}">
                <MenuItem Header="{DynamicResource Cad.Text.Distance}" Tag="measure.distance" Click="ActionClick"/>
            </MenuItem>
            <MenuItem Header="{DynamicResource Cad.Text.View}">
                <MenuItem Header="{DynamicResource Cad.Text.Fit}" Tag="view.fit" Click="ActionClick"/>
                <MenuItem Header="{DynamicResource Cad.Text.Isometric}" Tag="view.isometric" Click="ActionClick"/>
                <Separator/>
                <MenuItem Header="{DynamicResource Cad.Text.Top}" Tag="view.top" Click="ActionClick"/>
                <MenuItem Header="{DynamicResource Cad.Text.Bottom}" Tag="view.bottom" Click="ActionClick"/>
                <MenuItem Header="{DynamicResource Cad.Text.Front}" Tag="view.front" Click="ActionClick"/>
                <MenuItem Header="{DynamicResource Cad.Text.Back}" Tag="view.back" Click="ActionClick"/>
                <MenuItem Header="{DynamicResource Cad.Text.Left}" Tag="view.left" Click="ActionClick"/>
                <MenuItem Header="{DynamicResource Cad.Text.Right}" Tag="view.right" Click="ActionClick"/>
                <Separator/>
                <MenuItem Header="{DynamicResource Cad.Text.Wireframe}" Tag="display.wireframe" Click="ActionClick"/>
                <MenuItem Header="{DynamicResource Cad.Text.Shaded}" Tag="display.shaded" Click="ActionClick"/>
                <Separator/>
                <MenuItem Header="{DynamicResource Cad.Text.Visibility}">
                    <MenuItem Header="{DynamicResource Cad.Text.Hide}" Tag="view.hide" Click="ActionClick"/>
                    <MenuItem Header="{DynamicResource Cad.Text.Isolate}" Tag="view.isolate" Click="ActionClick"/>
                    <MenuItem Header="{DynamicResource Cad.Text.ShowAll}" Tag="view.showall" Click="ActionClick"/>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="{DynamicResource Cad.Text.Panels}">
                <MenuItem Header="{DynamicResource Cad.Text.Model}" Click="ToggleModelDockClick"/>
                <MenuItem Header="{DynamicResource Cad.Text.Layers}" Click="ToggleLayerDockClick"/>
                <MenuItem Header="{DynamicResource Cad.Text.Properties}" Click="TogglePropertyDockClick"/>
            </MenuItem>
            <MenuItem Header="{DynamicResource Cad.Text.Settings}">
                <MenuItem x:Name="ChineseLanguageMenuItem" Header="{DynamicResource Cad.Text.Chinese}" Tag="zh-CN" IsCheckable="True" Click="LanguageClick"/>
                <MenuItem x:Name="EnglishLanguageMenuItem" Header="{DynamicResource Cad.Text.English}" Tag="en-US" IsCheckable="True" Click="LanguageClick"/>
                <Separator/>
                <MenuItem x:Name="Polar15Menu" Header="{DynamicResource Cad.Text.Polar15}" Tag="15" IsCheckable="True" Click="PolarIncrementClick"/>
                <MenuItem x:Name="Polar30Menu" Header="{DynamicResource Cad.Text.Polar30}" Tag="30" IsCheckable="True" Click="PolarIncrementClick"/>
                <MenuItem x:Name="Polar45Menu" Header="{DynamicResource Cad.Text.Polar45}" Tag="45" IsCheckable="True" Click="PolarIncrementClick"/>
                <MenuItem x:Name="Polar90Menu" Header="{DynamicResource Cad.Text.Polar90}" Tag="90" IsCheckable="True" Click="PolarIncrementClick"/>
            </MenuItem>
        </Menu>

        <Border x:Name="ToolPromptPanel"
                DockPanel.Dock="Top"
                Padding="4,2"
                Background="#F0F0F0"
                BorderBrush="#D0D0D0"
                BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{DynamicResource Cad.Text.Layers}" VerticalAlignment="Center"/>
                <ComboBox Width="140" Height="24" Margin="4,0,8,0"
                          ItemsSource="{Binding ItemsSource, ElementName=LayerList}"
                          SelectedItem="{Binding SelectedItem, ElementName=LayerList, Mode=TwoWay}"
                          DisplayMemberPath="Name"/>
            </StackPanel>
        </Border>

        <StatusBar DockPanel.Dock="Bottom" Padding="2,0">
            <StatusBarItem HorizontalContentAlignment="Stretch">
                <TextBlock x:Name="ToolStatus" Text="{DynamicResource Cad.Text.Ready}" MinWidth="260" TextTrimming="CharacterEllipsis"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem><ToggleButton x:Name="SnapToggle" Content="SNAP" Padding="7,1" Checked="SnapChanged" Unchecked="SnapChanged"/></StatusBarItem>
            <StatusBarItem Padding="0">
                <Menu Background="Transparent" Padding="0">
                    <MenuItem x:Name="ObjectSnapMenu" Header="{DynamicResource Cad.Text.ObjectSnap}">
                        <MenuItem x:Name="EndpointSnapToggle" Header="{DynamicResource Cad.Text.SnapEndpoint}" IsCheckable="True" Checked="SnapModesChanged" Unchecked="SnapModesChanged"/>
                        <MenuItem x:Name="MidpointSnapToggle" Header="{DynamicResource Cad.Text.SnapMidpoint}" IsCheckable="True" Checked="SnapModesChanged" Unchecked="SnapModesChanged"/>
                        <MenuItem x:Name="CenterSnapToggle" Header="{DynamicResource Cad.Text.SnapCenter}" IsCheckable="True" Checked="SnapModesChanged" Unchecked="SnapModesChanged"/>
                        <MenuItem x:Name="VertexSnapToggle" Header="{DynamicResource Cad.Text.SnapVertex}" IsCheckable="True" Checked="SnapModesChanged" Unchecked="SnapModesChanged"/>
                        <MenuItem x:Name="QuadrantSnapToggle" Header="{DynamicResource Cad.Text.SnapQuadrant}" IsCheckable="True" Checked="SnapModesChanged" Unchecked="SnapModesChanged"/>
                        <Separator/>
                        <MenuItem Header="{DynamicResource Cad.Text.SnapTemporary}">
                            <MenuItem Header="{DynamicResource Cad.Text.SnapPersistent}" Tag="Persistent" Click="SnapTemporaryModeClick"/>
                            <MenuItem Header="{DynamicResource Cad.Text.SnapNone}" Tag="None" Click="SnapTemporaryModeClick"/>
                            <Separator/>
                            <MenuItem Header="{DynamicResource Cad.Text.SnapEndpoint}" Tag="Endpoint" Click="SnapTemporaryModeClick"/>
                            <MenuItem Header="{DynamicResource Cad.Text.SnapMidpoint}" Tag="Midpoint" Click="SnapTemporaryModeClick"/>
                            <MenuItem Header="{DynamicResource Cad.Text.SnapCenter}" Tag="Center" Click="SnapTemporaryModeClick"/>
                            <MenuItem Header="{DynamicResource Cad.Text.SnapVertex}" Tag="Vertex" Click="SnapTemporaryModeClick"/>
                            <MenuItem Header="{DynamicResource Cad.Text.SnapQuadrant}" Tag="Quadrant" Click="SnapTemporaryModeClick"/>
                        </MenuItem>
                    </MenuItem>
                </Menu>
            </StatusBarItem>
            <StatusBarItem Padding="1,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="WorkPlaneStatusLabel" Margin="4,0,3,0" VerticalAlignment="Center"/>
                    <ToggleButton x:Name="WorkPlaneXyToggle" Content="XY" Tag="XY" Padding="5,1" Click="WorkPlaneStatusClick"/>
                    <ToggleButton x:Name="WorkPlaneYzToggle" Content="YZ" Tag="YZ" Padding="5,1" Click="WorkPlaneStatusClick"/>
                    <ToggleButton x:Name="WorkPlaneXzToggle" Content="XZ" Tag="XZ" Padding="5,1" Click="WorkPlaneStatusClick"/>
                </StackPanel>
            </StatusBarItem>
            <StatusBarItem><ToggleButton x:Name="OrthoTrackingToggle" Content="ORTHO" Padding="7,1" Checked="TrackingChanged" Unchecked="TrackingChanged"/></StatusBarItem>
            <StatusBarItem><ToggleButton x:Name="PolarTrackingToggle" Content="POLAR" Padding="7,1" Checked="TrackingChanged" Unchecked="TrackingChanged"/></StatusBarItem>
            <Separator/>
            <StatusBarItem HorizontalAlignment="Right"><TextBlock x:Name="CoordinateStatus" MinWidth="210" TextAlignment="Right" Text="X 0.000  Y 0.000  Z 0.000"/></StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ModelDockColumn" Width="200" MinWidth="0"/>
                <ColumnDefinition x:Name="ModelSplitterColumn" Width="4"/>
                <ColumnDefinition Width="*" MinWidth="320"/>
                <ColumnDefinition x:Name="RightSplitterColumn" Width="4"/>
                <ColumnDefinition x:Name="RightDockColumn" Width="360" MinWidth="0"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="ModelDockPane" Grid.Column="0" BorderBrush="Gray" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="34"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <DockPanel Background="#F0F0F0">
                        <Button DockPanel.Dock="Right" Content="×" Width="24" Margin="2" Background="Transparent" BorderThickness="0" Click="ToggleModelDockClick"/>
                        <TextBlock Text="{DynamicResource Cad.Text.Model}" Margin="6,0" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBox Grid.Row="1" x:Name="ModelSearchBox" Margin="4" VerticalContentAlignment="Center" ToolTip="{DynamicResource Cad.Text.FilterModel}" TextChanged="ModelSearchTextChanged"/>
                    <TreeView Grid.Row="2"
                              x:Name="EntityTree"
                              SelectedItemChanged="EntityTreeSelectedItemChanged"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling"
                              ScrollViewer.CanContentScroll="True"/>
                </Grid>
            </Border>
            <GridSplitter x:Name="ModelDockSplitter" Grid.Column="1" HorizontalAlignment="Stretch" Width="4"/>
            <Border Grid.Column="2" Background="Black">
                <Grid x:Name="ViewportHost" ClipToBounds="True">
                    <occt:OcctWpfViewport x:Name="Viewport" RectangleSelectionThreshold="5" SynchronizeRenderDpi="True"/>
                    <Canvas IsHitTestVisible="False" ClipToBounds="True">
                        <Ellipse x:Name="SnapAperture" Visibility="Collapsed" Width="18" Height="18" Stroke="White" StrokeThickness="1" StrokeDashArray="2,2" Opacity="0.65"/>
                        <Border x:Name="DynamicInputHud" Visibility="Collapsed" Canvas.Left="12" Canvas.Top="12" MinWidth="110" MaxWidth="260" Padding="6,4" Background="WhiteSmoke" BorderBrush="Gray" BorderThickness="1">
                            <TextBlock x:Name="DynamicValueText" Foreground="Black"/>
                        </Border>
                    </Canvas>
                </Grid>
            </Border>
            <GridSplitter x:Name="RightDockSplitter" Grid.Column="3" HorizontalAlignment="Stretch" Width="4"/>
            <Grid x:Name="RightDockHost" Grid.Column="4">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="LayerDockRow" Height="0.46*"/>
                    <RowDefinition x:Name="RightDockRowSplitter" Height="4"/>
                    <RowDefinition x:Name="PropertyDockRow" Height="0.54*"/>
                </Grid.RowDefinitions>
                <Border x:Name="LayerDockPane" Grid.Row="0" BorderBrush="Gray" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="58"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="34"/>
                            <RowDefinition Height="22"/>
                        </Grid.RowDefinitions>
                        <DockPanel Background="#F0F0F0">
                            <Button DockPanel.Dock="Right" Content="×" Width="24" Margin="2" Background="Transparent" BorderThickness="0" Click="ToggleLayerDockClick"/>
                            <TextBlock Text="{DynamicResource Cad.Text.Layers}" Margin="6,0" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="30"/></Grid.RowDefinitions>
                            <TextBox x:Name="LayerSearchBox" Grid.Row="0" Margin="4,3,4,2" VerticalContentAlignment="Center" ToolTip="{DynamicResource Cad.Text.FilterLayers}" TextChanged="LayerSearchTextChanged"/>
                            <DockPanel Grid.Row="1" Margin="2,0,2,2">
                                <Button Content="{DynamicResource Cad.Text.New}" Margin="2" Padding="6,1" Click="CreateLayerClick"/>
                                <Button Content="{DynamicResource Cad.Text.Rename}" Margin="2" Padding="6,1" Click="RenameLayerClick"/>
                                <Button Content="{DynamicResource Cad.Text.Remove}" Margin="2" Padding="6,1" Click="RemoveLayerClick"/>
                                <Button DockPanel.Dock="Right" Width="56" Content="{DynamicResource Cad.Text.Refresh}" Margin="2" Padding="4,1" Click="RefreshLayerClick"/>
                            </DockPanel>
                        </Grid>
                        <DataGrid Grid.Row="2" x:Name="LayerList" Margin="3" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionMode="Single" SelectionChanged="LayerSelectionChanged">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow"><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
                            </DataGrid.RowStyle>
                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell"><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
                            </DataGrid.CellStyle>
                        </DataGrid>
                        <UniformGrid Grid.Row="3" Columns="2" Margin="3,1">
                            <Button Content="{DynamicResource Cad.Text.AssignSelection}" Margin="2" Click="AssignLayerClick"/>
                            <Button Content="{DynamicResource Cad.Text.Properties}" Margin="2" Click="LayerPropertiesClick"/>
                        </UniformGrid>
                        <Grid Grid.Row="4">
                            <TextBlock x:Name="LayerStatus" Margin="5,0" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>
                    </Grid>
                </Border>
                <GridSplitter x:Name="LayerPropertySplitter" Grid.Row="1" Height="4" HorizontalAlignment="Stretch"/>
                <Border x:Name="PropertyDockPane" Grid.Row="2" BorderBrush="Gray" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <DockPanel Background="#F0F0F0">
                            <Button DockPanel.Dock="Right" Content="×" Width="24" Margin="2" Background="Transparent" BorderThickness="0" Click="TogglePropertyDockClick"/>
                            <TextBlock Text="{DynamicResource Cad.Text.Properties}" Margin="6,0" VerticalAlignment="Center"/>
                        </DockPanel>
                        <wfi:WindowsFormsHost Grid.Row="1" Margin="1">
                            <wf:PropertyGrid x:Name="PropertyInspector" ToolbarVisible="False" HelpVisible="True" PropertySort="Categorized"/>
                        </wfi:WindowsFormsHost>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>




