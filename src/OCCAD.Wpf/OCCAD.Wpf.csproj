<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>OCCAD</AssemblyName>
    <RootNamespace>OCCAD.Wpf</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <OcctBridgeDistRoot Condition="'$(OcctBridgeDistRoot)' == ''">$(MSBuildThisFileDirectory)..\..\external\OcctCSharpBridge\win-x64</OcctBridgeDistRoot>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\OCCAD.Core\OCCAD.Core.csproj" />
    <Reference Include="OcctNet">
      <HintPath>$(OcctBridgeDistRoot)\OcctNet.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="OcctNet.Wpf">
      <HintPath>$(OcctBridgeDistRoot)\OcctNet.Wpf.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <Target Name="ValidateCadWpfBridgeSdk" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(OcctBridgeDistRoot)\OcctNet.Wpf.dll')" Text="OcctNet.Wpf.dll is missing. Run .\build.ps1 -SyncBridge -BridgeBranch main once." />
    <Error Condition="!Exists('$(OcctBridgeDistRoot)\OcctNative.dll')" Text="OcctNative.dll is missing. Run .\build.ps1 -SyncBridge -BridgeBranch main once." />
  </Target>
  <Target Name="CopyCadNativeBridge" AfterTargets="Build">
    <Copy SourceFiles="$(OcctBridgeDistRoot)\OcctNative.dll" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
